# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC...

# "polling" for local development, "webhook" for production (Render)
BOT_MODE=polling

# Public https URL of the service (only for webhook mode), e.g. https://anki-tg-bot.onrender.com
PUBLIC_URL=

# Random string; Telegram sends it in the X-Telegram-Bot-Api-Secret-Token header (webhook mode)
WEBHOOK_SECRET=change-me-long-random-string

# Postgres connection string (Neon free tier recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/anki_bot

# Secret for POST /jobs/tick (called by an external cron every 5–10 minutes)
JOBS_SECRET=change-me-another-random-string

# Optional: comma-separated Telegram user ids that may use the bot. Empty = everyone.
ALLOWED_TELEGRAM_IDS=

# Default timezone for new users
DEFAULT_TIMEZONE=Europe/Berlin

PORT=3000
